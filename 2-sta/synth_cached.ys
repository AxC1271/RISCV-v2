read_verilog -sv ../0-rtl/core_riscv_cached.sv
read_verilog -sv ../0-rtl/program_counter.sv
read_verilog -sv ../0-rtl/instr_cache.sv
read_verilog -sv ../0-rtl/data_cache.sv
read_verilog -sv ../0-rtl/ifid_register.sv
read_verilog -sv ../0-rtl/idex_register.sv
read_verilog -sv ../0-rtl/exmem_register.sv
read_verilog -sv ../0-rtl/memwb_register.sv
read_verilog -sv ../0-rtl/control_unit.sv
read_verilog -sv ../0-rtl/immediate_generator.sv
read_verilog -sv ../0-rtl/register_file.sv
read_verilog -sv ../0-rtl/alu.sv
read_verilog -sv ../0-rtl/branch_unit.sv
read_verilog -sv ../0-rtl/forward_unit.sv
read_verilog -sv ../0-rtl/hazard_unit.sv

chparam -set NUM_SETS 4 instr_cache
chparam -set CACHE_SIZE 64 data_cache

hierarchy -check -top core_riscv_cached

synth -top core_riscv_cached
opt -purge
memory -nomap
opt -purge

dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib

abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib \
    -dont_use sky130_fd_sc_hd__*_0 \
    -constr constraints.sdc \
    -D 8000

splitnets -ports
opt_clean -purge

tee -o synth_stats_cached.txt stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr -noexpr core_riscv_cached_synth.v