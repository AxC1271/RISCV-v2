read_verilog -sv core_riscv_cached.sv
read_verilog -sv program_counter.sv
read_verilog -sv instr_cache.sv
read_verilog -sv data_cache.sv
read_verilog -sv ifid_register.sv
read_verilog -sv idex_register.sv
read_verilog -sv exmem_register.sv
read_verilog -sv memwb_register.sv
read_verilog -sv control_unit.sv
read_verilog -sv immediate_generator.sv
read_verilog -sv register_file.sv
read_verilog -sv alu.sv
read_verilog -sv branch_unit.sv
read_verilog -sv forward_unit.sv
read_verilog -sv hazard_unit.sv

chparam -set NUM_SETS 32 instr_cache
chparam -set CACHE_SIZE 1024 data_cache

hierarchy -check -top core_riscv_cached
synth -top core_riscv_cached
flatten
opt_clean

dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib -D 20000
opt_clean -purge

tee -o synth_stats_cached.txt stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr -noexpr core_riscv_synth.v
